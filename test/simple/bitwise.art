#[export]
fn main() -> i32 {
    let a = 0b1010 : i32;
    let b = 0b1100 : i32;
    let c = a & b;       // 0b1000 = 8
    let d = a | b;       // 0b1110 = 14
    let e = a ^ b;       // 0b0110 = 6
    let f = a << 1;      // 0b10100 = 20
    let g = b >> 1;      // 0b0110 = 6
    c + d + e + f + g    // 8 + 14 + 6 + 20 + 6 = 54
}
