mod builtin {
    struct CastOp[S, T] {
        cast : fn(S) -> T
    }
}

struct Vec2[T] {
    x : T,
    y : T
}

implicit builtin::CastOp[Vec2[f32], Vec2[i32]] = builtin::CastOp[Vec2[f32], Vec2[i32]] {
    cast = @|a : Vec2[f32]| {
        Vec2[i32] {
            x = a.x as i32,
            y = a.y as i32
        }
    }
};


#[export]
fn main () -> i32 {
    let mut k = 0 : i32;

    let a = Vec2[f32] {
        x = 1,
        y = 2
    };

    let b = a as Vec2[i32];

    k = b.x + b.y;

    k
}
